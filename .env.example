# Agent-Z configuration template
# Copy this file to .env and edit as needed

# Target project
PROJECT_DIR=G:\Code\workspace_aieng

# GitHub repository (owner/repo)
GITHUB_REPO=armpro24-blip/cad-cae-copilot

# Agent backends: claude, codex, opencode
DEFAULT_BACKEND=claude
# ANALYST_BACKEND=claude
# DEVELOPER_BACKEND=claude
# REVIEWER_BACKEND=codex
# SUBMITTER_BACKEND=claude

# Backend CLI flags
CLAUDE_FLAGS=--dangerously-skip-permissions
CODEX_FLAGS=--dangerously-bypass-approvals-and-sandbox
OPENCODE_FLAGS=

# Agent timeouts (seconds)
TIMEOUT_ANALYST=3600
TIMEOUT_DEVELOPER=10800
TIMEOUT_REVIEWER=1800
TIMEOUT_SUBMITTER=600
RETRY_TIMEOUT=3600

# PR checks
PR_CHECKS_INTERVAL=10
PR_CHECKS_MAX_WAIT=900
MAX_REVIEW_ROUNDS=5
MAX_LOCAL_REVIEW_ROUNDS=5
