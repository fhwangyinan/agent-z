# Agent-Z configuration template
# Copy this file to .env and edit as needed

# Target project
PROJECT_DIR=G:\Code\workspace_aieng

# GitHub repository (owner/repo)
GITHUB_REPO=armpro24-blip/cad-cae-copilot
SKIP_LABELS=ongoing

# Runtime state
# AGENT_Z_HOME=G:\Code\agent-z\.agent-z
# STATE_DB=G:\Code\agent-z\.agent-z\state.db
# WORKTREE_ROOT=G:\Code\agent-z\.agent-z\worktrees

# Agent backends: claude, codex, opencode
DEFAULT_BACKEND=claude
# TASK_LEAD_BACKEND=claude
# REVIEWER_BACKEND=codex

# Backend CLI flags
CLAUDE_FLAGS=--dangerously-skip-permissions
CODEX_FLAGS=--dangerously-bypass-approvals-and-sandbox
OPENCODE_FLAGS=

# Agent timeouts (seconds)
TIMEOUT_ANALYST=3600
TIMEOUT_DEVELOPER=10800
TIMEOUT_REVIEWER=1800
RETRY_TIMEOUT=3600
GITHUB_RETRY_ATTEMPTS=3
GITHUB_RETRY_BASE_DELAY=2
GITHUB_RETRY_MAX_DELAY=30
GITHUB_COMMAND_TIMEOUT=60

# PR checks
PR_CHECKS_INTERVAL=10
PR_CHECKS_MAX_WAIT=900
MAX_REVIEW_ROUNDS=5
MAX_LOCAL_REVIEW_ROUNDS=5

# Run control
MAX_PARALLEL_TASKS=2
# SERVICE_WORKERS=2
SERVICE_RESTART_DELAY=5
SERVICE_RESTART_MAX_DELAY=60
SERVICE_RESTART_MAX_ATTEMPTS=5
SERVICE_RESTART_RESET_SECONDS=300
SERVICE_LOG_MAX_BYTES=5242880
SERVICE_LOG_BACKUPS=3
MAX_RUN_SECONDS=21600
CLEANUP_COMPLETED_WORKTREES=true
CLEANUP_FAILED_WORKTREES=false
WORKER_IDLE_SLEEP=30
WORKER_PREFLIGHT_MAX_RETRIES=3
PLANNER_IDLE_SLEEP=30
PLANNER_MAX_RETRIES=3
PLANNER_RETRY_BASE_DELAY=10
SCHEDULER_IDLE_SLEEP=60
SCHEDULER_BATCH_SIZE=10
SCHEDULER_ISSUE_LIMIT=100
SCHEDULER_PR_LIMIT=500
# Maximum hard-filtered candidates sent to the Scheduler Agent per scan.
SCHEDULER_AGENT_CANDIDATE_LIMIT=100
# Empty means all open issues are eligible. Set e.g. agent-ready to require that label.
SCHEDULER_ELIGIBLE_LABELS=
SCHEDULER_BLOCK_LABELS=blocked
SCHEDULER_SKIP_ASSIGNED_ISSUES=true
SCHEDULER_PRIORITY_LABELS=priority:critical,priority:high,priority:medium,priority:low
RECONCILER_INTERVAL=60
PLANNER_LEASE_SECONDS=7200
WORKER_LEASE_SECONDS=21600
